TELEGRAM_BOT_TOKEN=replace_with_botfather_token
VISION_BASE_URL=https://your-openai-compatible-provider.example/v1
VISION_API_KEY=replace_with_provider_api_key
# Optional: restrict the bot to one Telegram numeric user ID.
ALLOWED_TELEGRAM_ID=
# Use an exact vision-capable model id returned by GET /models.
VISION_MODEL=replace_with_a_vision_capable_model_id
# Calora API receives the user-reviewed result. Use the same secret as the server.
CALORA_API_URL=http://localhost:3005
CALORA_WEBHOOK_TOKEN=replace_with_a_long_random_secret
