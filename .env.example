# Required in production. Plain passwords are hashed with scrypt during first-time seeding;
# passwordHash may be supplied instead. Roles: USER or ADMIN.
CALORA_USERS_JSON=[{"id":"user-1","name":"User","email":"user@example.test","password":"change-me","role":"USER","profile":{"bb":68,"tb":175,"age":25,"sex":"male","activity":"moderate","goal":"maintain"}},{"id":"admin-1","name":"Admin","email":"admin@example.test","password":"change-admin-password","role":"ADMIN","profile":{"bb":70,"tb":175,"age":30,"sex":"male","activity":"moderate","goal":"maintain"}}]

# Shared only with trusted importers such as Health Connect and the Telegram bot.
CALORA_WEBHOOK_TOKEN=replace_with_a_long_random_secret

# Optional data location and port.
CALORA_DATA_DIR=
PORT=3005

# Catering and Telegram binding.
CALORA_CATERING_CUTOFF_HOUR=20
TELEGRAM_BIND_TTL_MINUTES=30
TELEGRAM_BOT_USERNAME=Calor4_bot

# Strava remains disabled because its 2026 policy blocks Calora's intended
# cross-data adaptive/AI use. This flag is documentary; no OAuth is activated.
STRAVA_INTEGRATION_ENABLED=false
